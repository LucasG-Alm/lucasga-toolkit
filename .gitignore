# ---------------------------------------------------------------
# DADOS DE CLIENTE — este repositório é PÚBLICO.
# Nenhum arquivo de projeto real (Proesplan, contratos) pode entrar.
# Estas regras vêm primeiro de propósito.
# ---------------------------------------------------------------
*.dwg
*.dxf
*.dwl
*.dwl2
*.bak
*.sv$
*.dws
*.dwt
*.csv
*.xlsx
*.xls
*.pdf
*.las
*.laz
*.xml
!docs/**/*.xml

# pastas de trabalho local (nunca versionar)
/local/
/dados/
/refs/dwg/
/scratch/

# Relatórios de erro do AutoCAD (CER) — podem conter conteúdo do desenho
ErrorReports/
*.dmp

# ---------------------------------------------------------------
# Notas do vault Obsidian que moram na pasta do projeto.
# A nota principal tem wikilinks e referencias de contrato — nao vai
# para repositorio publico. Só README e CLAUDE sao do repo.
# ---------------------------------------------------------------
/*.md
!/README.md
!/CLAUDE.md

# ---------------------------------------------------------------
# .NET
# ---------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
*.userprefs
.vs/
.vscode/
*.dll
*.pdb
*.exe
!lib/**/*.dll

# ---------------------------------------------------------------
# Sistema
# ---------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*.log
plot.log

# ---------------------------------------------------------------
# Vault Obsidian — logs internos, nunca vão para repositório
# ---------------------------------------------------------------
_HomePage/
*.canvas
.obsidian/

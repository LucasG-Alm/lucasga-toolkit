{
  "name": "lucasga-toolkit-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Interface local para automações CAD, coordenadas e estudos de drenagem",
  "author": "LucasGA",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "smoke": "node scripts/smoke.mjs",
    "export:design": "node scripts/export-design.mjs",
    "prototype:themes": "node scripts/prototype-themes.mjs --serve",
    "prototype:location": "node scripts/prototype-location.mjs",
    "pack": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.lucasga.toolkit",
    "productName": "LucasGA Toolkit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../ferramentas",
        "to": "toolkit/ferramentas",
        "filter": [
          "**/*.py",
          "**/*.txt",
          "**/*.aff",
          "**/*.dic",
          "**/*.lsp",
          "**/*.json",
          "**/*.md",
          "!**/regressao/**",
          "!**/__pycache__/**",
          "!**/test_*.py",
          "!**/.pytest_cache/**"
        ]
      },
      {
        "from": "python",
        "to": "toolkit/desktop/python",
        "filter": [
          "*.py",
          "!test_*.py"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
